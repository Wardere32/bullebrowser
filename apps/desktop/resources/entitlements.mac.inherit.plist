<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Inherited by Electron helper (child) processes under the hardened
         runtime. Must mirror the parent JIT / library-validation exceptions
         and set com.apple.security.inherit so the sandbox/runtime flags flow
         down from the main app. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- com.apple.security.inherit MUST stand alone among App Sandbox
         entitlements: it means "take the parent's", and Apple rejects it when
         combined with another sandbox entitlement. Adding
         com.apple.security.device.audio-input here alongside it (to give the
         helper the microphone) produced an invalid entitlement set and failed
         signing/notarization every time — v0.2.24 and v0.2.25 both died in the
         "Build, sign & notarize macOS installer" step because of it.
         The helper gets the microphone by inheriting it from the app; the
         audio-input entitlement belongs only in entitlements.mac.plist. -->
    <key>com.apple.security.inherit</key>
    <true/>
  </dict>
</plist>
